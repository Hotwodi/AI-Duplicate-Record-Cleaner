<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Merge History: Tree View -->
    <record id="drc_merge_history_tree" model="ir.ui.view">
        <field name="name">drc.merge.history.tree</field>
        <field name="model">drc.merge.history</field>
        <field name="arch" type="xml">
            <tree string="Merge History">
                <field name="name"/>
                <field name="model_name"/>
                <field name="master_record_id"/>
                <field name="merged_by"/>
                <field name="merge_date"/>
            </tree>
        </field>
    </record>

    <!-- Merge History: Form View -->
    <record id="drc_merge_history_form" model="ir.ui.view">
        <field name="name">drc.merge.history.form</field>
        <field name="model">drc.merge.history</field>
        <field name="arch" type="xml">
            <form string="Merge History">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name" readonly="1"/>
                            <field name="master_record_id" readonly="1"/>
                            <field name="merged_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="merge_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Merged Record IDs">
                        <field name="merged_record_ids" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Fields Merged">
                        <field name="fields_merged" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Merge History: Action -->
    <record id="drc_merge_history_action" model="ir.actions.act_window">
        <field name="name">Merge History</field>
        <field name="res_model">drc.merge.history</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No merge history records found
            </p>
            <p>
                Every merge operation is logged here for full auditability
                and traceability.
            </p>
        </field>
    </record>
</odoo>
